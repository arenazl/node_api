# Puerto del servidor
PORT=3000

# Entorno (development, production)
NODE_ENV=development

# Límite de tamaño de archivo en MB
FILE_UPLOAD_SIZE_LIMIT=50

# Timeout de requests en ms
REQUEST_TIMEOUT=120000

# Origenes permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Logs detallados (true/false)
# Cuando está en false, solo muestra logs resumidos con emojis
# Cuando está en true, muestra todos los logs detallados
VERBOSE_LOGS=false

# Configuración de base de datos (opcional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mq_importer
DB_USER=your_user
DB_PASSWORD=your_password